APP_NAME=Palabre
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=palabre
DB_USERNAME=palabre
DB_PASSWORD=
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

BROADCAST_CONNECTION=reverb

# Temps réel (Laravel Reverb, licence MIT) : l'API publie vers le conteneur « reverb » (REVERB_HOST),
# le navigateur se connecte à REVERB_PUBLIC_* (en local : le port 8090 publié par docker compose).
# Clé et secret : n'importe quelles chaînes aléatoires (ex. openssl rand -hex 16). Mettre BROADCAST_CONNECTION=null pour désactiver.
REVERB_APP_ID=palabre
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_PUBLIC_HOST=localhost
REVERB_PUBLIC_PORT=8090
REVERB_PUBLIC_SCHEME=http
REVERB_PUBLIC_PATH=
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=predis
REDIS_HOST=valkey
REDIS_PASSWORD=null
REDIS_PORT=6379

# E-mails (codes de vérification, mot de passe oublié, primes, retraits, alertes) : SMTP Brevo
# En local, MAIL_MAILER=log écrit les e-mails dans storage/logs/laravel.log (aucun envoi réel)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=marememakalou10@outlook.fr
MAIL_FROM_NAME=Palabre
# Vérification de l'adresse e-mail par code à l'inscription (false seulement pour une démo sans serveur de mail)
EMAIL_VERIFICATION=true

# PayTech (paytech.sn) : recharge du portefeuille. Sans clés, les recharges sont simulées (mode test).
# Clés dans votre espace PayTech, rubrique « Paramètres > API ». URL de notification (IPN) : <APP_URL>/api/paytech/ipn
PAYTECH_API_KEY=
PAYTECH_API_SECRET=
PAYTECH_ENV=test

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Front-end React (cookies de session Sanctum)
FRONTEND_URL=http://localhost:5180
SANCTUM_STATEFUL_DOMAINS=localhost:5180

# Comptes de démonstration (seeder) : mettre des mots de passe forts en production
DEMO_OWNER_EMAIL=marememakalou10@gmail.com
DEMO_TEAMMATE_EMAIL=mlletech11@gmail.com
# Mot de passe de tous les comptes de démonstration (équipe comprise)
DEMO_PASSWORD=
# true : la page de connexion propose les comptes de démo et leur mot de passe (jury du concours)
DEMO_ACCOUNTS_PUBLIC=false

# Production : HTTPS terminé par le serveur web (Caddy/nginx) sur la même machine
# TRUSTED_PROXIES=127.0.0.1
# SESSION_SECURE_COOKIE=true
# APP_ENV=production et APP_DEBUG=false
