# Configuration de production : copier en deploy/.env et compléter. Ce fichier n'est jamais versionné.

APP_NAME=Palabre
APP_ENV=production
APP_DEBUG=false
# Générer avec : docker compose run --rm app php artisan key:generate --show
APP_KEY=
APP_URL=https://palabre.exemple.sn
# Interface en français ou en anglais ; le français est la langue de repli
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

# Nom de domaine servi par Caddy : le certificat HTTPS est obtenu et renouvelé automatiquement (Let's Encrypt).
# Sans nom de domaine (adresse IP seule) : SERVER_NAME=:80 et APP_URL=http://ADRESSE_IP
SERVER_NAME=palabre.exemple.sn
# Facultatif : autres noms redirigés vers SERVER_NAME, séparés par des espaces (ex. www.palabre.exemple.sn)
SERVER_ALIASES=

# Journaux lisibles avec « docker compose logs app »
LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=palabre
DB_USERNAME=palabre
# Long et aléatoire, par exemple : openssl rand -base64 24
DB_PASSWORD=

REDIS_CLIENT=predis
REDIS_HOST=valkey
REDIS_PORT=6379
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=sync

# Cookies de session : HTTPS seulement, et le front-end est servi par le même domaine
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SANCTUM_STATEFUL_DOMAINS=palabre.exemple.sn
FRONTEND_URL=https://palabre.exemple.sn

BCRYPT_ROUNDS=12
# E-mails (codes de vérification, mot de passe oublié, primes, retraits, alertes) : SMTP Brevo
# En local, MAIL_MAILER=log écrit les e-mails dans storage/logs/laravel.log (aucun envoi réel)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=marememakalou10@outlook.fr
MAIL_FROM_NAME=Palabre
# Vérification de l'adresse e-mail par code à l'inscription (false seulement pour une démo sans serveur de mail)
EMAIL_VERIFICATION=true

# PayTech (paytech.sn) : recharge du portefeuille. Sans clés, les recharges sont simulées (mode test).
# Clés dans votre espace PayTech, rubrique « Paramètres > API ». URL de notification (IPN) : <APP_URL>/api/paytech/ipn
PAYTECH_API_KEY=
PAYTECH_API_SECRET=
PAYTECH_ENV=test

# Comptes de démonstration créés par « php artisan db:seed » (équipe et comptes de démo, même mot de passe)
DEMO_OWNER_EMAIL=marememakalou10@gmail.com
DEMO_TEAMMATE_EMAIL=mlletech11@gmail.com
DEMO_PASSWORD=
# true : la page de connexion propose les comptes de démo (jury du concours) ; leur mot de passe devient public
DEMO_ACCOUNTS_PUBLIC=true

# Temps réel (Laravel Reverb) : les navigateurs se connectent en wss://VOTRE-DOMAINE/reverb, Caddy relaie vers le conteneur reverb.
# Clé et secret : chaînes aléatoires (openssl rand -hex 16). Sans nom de domaine : REVERB_PUBLIC_PORT=80 et REVERB_PUBLIC_SCHEME=http.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=palabre
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# Vide : l'adresse par laquelle le visiteur est arrivé (utile si le site répond à plusieurs noms)
REVERB_PUBLIC_HOST=
REVERB_PUBLIC_PORT=443
REVERB_PUBLIC_SCHEME=https
REVERB_PUBLIC_PATH=reverb
