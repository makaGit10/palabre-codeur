# Configuration de production : copier en deploy/.env et compléter. Ce fichier n'est jamais versionné.

APP_NAME=Palabre
APP_ENV=production
APP_DEBUG=false
# Générer avec : docker compose run --rm app php artisan key:generate --show
APP_KEY=
APP_URL=https://palabre.exemple.sn
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en

# Nom de domaine servi par Caddy : le certificat HTTPS est obtenu et renouvelé automatiquement (Let's Encrypt).
# Sans nom de domaine (adresse IP seule) : SERVER_NAME=:80 et APP_URL=http://ADRESSE_IP
SERVER_NAME=palabre.exemple.sn

# Journaux lisibles avec « docker compose logs app »
LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=palabre
DB_USERNAME=palabre
# Long et aléatoire, par exemple : openssl rand -base64 24
DB_PASSWORD=

REDIS_CLIENT=predis
REDIS_HOST=valkey
REDIS_PORT=6379
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=sync

# Cookies de session : HTTPS seulement, et le front-end est servi par le même domaine
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SANCTUM_STATEFUL_DOMAINS=palabre.exemple.sn
FRONTEND_URL=https://palabre.exemple.sn

BCRYPT_ROUNDS=12
MAIL_MAILER=log

# Comptes de démonstration créés par « php artisan db:seed » : mots de passe forts obligatoires en production
# (12 caractères minimum, le seeder refuse les mots de passe faibles).
DEMO_OWNER_EMAIL=marememakalou10@gmail.com
DEMO_OWNER_PASSWORD=
DEMO_PASSWORD=
# true : la page de connexion propose les comptes de démo (jury du concours) ; leur mot de passe devient public
DEMO_ACCOUNTS_PUBLIC=true
